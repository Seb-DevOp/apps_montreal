# =============================================================================
# Montréal Compagnon — variables d'environnement de DÉPLOIEMENT
# Copier en `.env` puis renseigner. `deploy.sh` charge ce fichier.
# Aucune de ces valeurs n'est compilée en dur dans la PWA (voir config.json).
# =============================================================================

# --- Projet GCP (change tous les 3 mois lors de la migration Free Tier) ------
GCP_PROJECT_ID=mtl-compagnon-2026q1
GCP_REGION=europe-west1
GCP_BILLING_ACCOUNT=

# --- Domaine stable : LA clé de la migration transparente --------------------
# Ce domaine ne change JAMAIS. Il est repointé sur le nouveau site Firebase
# Hosting à chaque migration -> les PWA installées continuent de fonctionner.
STABLE_DOMAIN=montreal.mondomaine.fr

# --- Identité admin ----------------------------------------------------------
# Email du compte qui recevra le custom claim { role: "admin" }
ADMIN_EMAIL=sebwow73@gmail.com

# --- CI GitHub Actions -------------------------------------------------------
# Dépôt autorisé à emprunter l'identité du service account GCP, au format
# proprietaire/depot. Utilisé par scripts/bootstrap-ci.sh pour restreindre le
# provider Workload Identity : sans cette condition, n'importe quel dépôt
# GitHub pourrait présenter un jeton et prendre l'identité de la CI.
# Laisser vide pour le déduire automatiquement du remote git « origin ».
GITHUB_REPOSITORY=

# --- Voyage ------------------------------------------------------------------
TRIP_DEPARTURE_DATE=2026-10-12
TRIP_RETURN_DATE=2026-10-26

# --- Secrets applicatifs (poussés dans Secret Manager par deploy.sh) ---------
# Clé OpenWeatherMap (offre gratuite) pour la météo « ressenti réel »
OPENWEATHER_API_KEY=

# --- Cloud Run ---------------------------------------------------------------
CLOUD_RUN_SERVICE=mtl-api
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=3
CLOUD_RUN_MEMORY=512Mi
