# =============================================================================
# Développement LOCAL uniquement.
#
# En production, ces variables ne servent à rien : la PWA lit sa configuration
# dans `/config.json`, généré par deploy.sh et servi par Firebase Hosting.
# C'est ce qui permet de changer de projet GCP sans rebuild ni réinstallation
# côté utilisateur.
#
# Copier en `web/.env.local`. Les valeurs se récupèrent avec :
#   firebase apps:sdkconfig WEB --project <projet>
# =============================================================================

VITE_APP_VERSION=dev
VITE_API_BASE_URL=/api

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mon-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mon-projet
VITE_FIREBASE_STORAGE_BUCKET=mon-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_TRIP_NAME=Montréal
VITE_TRIP_DEPARTURE=2026-10-12
VITE_TRIP_RETURN=2026-10-26
