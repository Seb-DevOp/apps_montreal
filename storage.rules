rules_version = '2';

// =============================================================================
// Montréal Compagnon — règles Cloud Storage
//
// L'application ne téléverse plus rien depuis la suppression du journal photo.
// Le bucket reste provisionné par Terraform (Firebase le crée d'office avec le
// projet), mais AUCUN accès n'est accordé : ni lecture, ni écriture.
//
// Refuser explicitement plutôt que laisser des règles permissives sur un
// bucket inutilisé — une surface d'attaque oubliée est la pire des surfaces.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
