rules_version = '2';

// =============================================================================
// Montréal Compagnon — règles Firestore
//
// APPLICATION MONO-UTILISATEUR.
//
// Il n'y a plus ni rôles, ni invités, ni partage : un seul compte accède à
// l'intégralité des données. Tout le reste est refusé, y compris en lecture.
//
// Le propriétaire est identifié par son ADRESSE E-MAIL vérifiée, et non par
// son UID. C'est délibéré : les UID Firebase sont propres à un projet et
// changeraient à chaque migration trimestrielle, ce qui casserait ces règles.
// L'adresse, elle, reste la même.
//
// `email_verified` est exigé : sans lui, un fournisseur d'identité laxiste
// pourrait présenter un jeton portant une adresse non prouvée.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return 'sebwow73@gmail.com';
    }

    // `token.get(clé, défaut)` est obligatoire : lire `token.email`
    // directement lève « Property email is undefined on object » si la
    // revendication est absente, ce qui refuserait tout accès sans expliquer
    // pourquoi.
    function isOwner() {
      return request.auth != null
        && request.auth.token.get('email', '') == ownerEmail()
        && request.auth.token.get('email_verified', false) == true;
    }

    // Une seule règle, appliquée à tout : profil, voyage, tâches, spots,
    // lexique, candidatures, caches. Aucune exception à maintenir.
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
